+            "tool": "check_meta_tags",
+            "field": "canonical",
+            "value": "http://www.incometax.gov.in/iec/foportal/"
+          },
+          {
+            "tool": "fetch_page",
+            "field": "is_https",
+            "value": "true"
+          }
+        ],
+        "fix": "Change the canonical link tag to https://www.incometax.gov.in/iec/foportal/.",
+        "impact": "high",
+        "effort": "low"
+      },
+      {
+        "category": "meta_tags",
+        "issue": "The page has no meta description, so search engines will generate their own snippet.",
+        "evidence": [
+          {
+            "tool": "check_meta_tags",
+            "field": "description",
+            "value": "null"
+          }
+        ],
+        "fix": "Add a meta description of 70-160 characters, e.g. 'File income tax returns, pay taxes, check refunds and get the latest updates on the official Income Tax Department e-Filing portal.'",
+        "impact": "high",
+        "effort": "low"
+      },

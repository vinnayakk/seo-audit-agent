+        "category": "meta_tags",
+        "issue": "The page has 7 H1 tags (one empty), which blurs the main topic signal.",
+        "evidence": [
+          {
+            "tool": "check_meta_tags",
+            "field": "h1",
+            "value": "[\"\", \"What's New\", \"Quick Links\", \"Latest Updates\", \"Important Deadlines\", \"Things to Know\", \"Our Success Enablers\"]"
+          }
+        ],
+        "fix": "Keep one descriptive H1 for the page and change the section headings (What's New, Quick Links, etc.) to H2; remove the empty H1.",
+        "impact": "medium",
+        "effort": "low"
+      },
+      {
+        "category": "meta_tags",
+        "issue": "The title is generic and short ('Home | ...'), and the Open Graph tags are incomplete (no og:description or og:image), so shared links have poor previews.",
